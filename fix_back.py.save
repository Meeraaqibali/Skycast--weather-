with open("lib/main.dart") as f:
    c = f.read()

# 1. Make back button smaller (46 → 38)
c = c.replace(
    """              GestureDetector(
                onTap: () => Navigator.pop(context),
                child: Container(
                  width: 46, height: 46,
                  decoration: BoxDecoration(color: widget.txt, shape: BoxShape.circle),
                  child: Icon(Icons.arrow_back, color: widget.bg1, size: 22),
                ),
              ),""",
    """              GestureDetector(
                onTap: () => Navigator.pop(context),
                child: Container(
                  width: 38, height: 38,
                  decoration: BoxDecoration(color: widget.txt, shape: BoxShape.circle),
                  child: Icon(Icons.arrow_back, color: widget.bg1, size: 18),
                ),
              ),"""
)

# 2. Slow down the page route transition (900/700 → 1300/1100)
c = c.replace(
    "transitionDuration: const Duration(milliseconds: 900),\n      reverseTransitionDuration: const Duration(milliseconds: 700),",
    "transitionDuration: const Duration(milliseconds: 1300),\n      reverseTransitionDuration: const Duration(milliseconds: 1100),"
)

# Also slow down in case it's the other form
c = c.replace(
    "transitionDuration: const Duration(milliseconds: 900),",
    "transitionDuration: const Duration(milliseconds: 1300),"
)
c = c.replace(
    "reverseTransitionDuration: const Duration(milliseconds: 700),",
    "reverseTransitionDuration: const Duration(milliseconds: 1100),"
)

with open("lib/main.dart", "w") as f:
    f.write(c)

print("=== CHECK ===")
print("Back button 38px:", "width: 38, height: 38" in c)
print("Icon 18px:", "Icon(Icons.arrow_back, color: widget.bg1, size: 18)" in c)
print("Page open 1300ms:", "milliseconds: 1300" in c)
print("Page close 1100ms:", "milliseconds: 1100" in c)
print()
print("Balanced:", c.count('{') == c.count('}') and c.count('(') == c.count(')'))
